<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}
body{
    font-family:Verdana, Geneva, sans-serif;
    background:linear-gradient(to right,#E3F2FD,#FFF3E0,#E8F5E9);
}
header{
    background:linear-gradient(to right,#6A11CB,#2575FC);
    color:white;
    text-align:center;
    padding:30px;
}
header h1{
    font-size:45px;
    letter-spacing:4px;
    text-shadow:3px 3px 6px black;
}
header p{
    font-size:20px;
    font-style:italic;
}
nav{
    background:#FF9800;
    text-align:center;
    padding:15px;
}
nav a{
    display:inline-block;
    text-decoration:none;
    color:white;
    background:#E91E63;
    padding:12px 22px;
    margin:8px;
    border-radius:25px;
    font-weight:bold;
}
nav a:hover{
    background:#4CAF50;
}
nav a:active{
    background:#F44336;
}
section{
    width:90%;
    margin:30px auto;
}
img{
    display:block;
    width:100%;
    height:400px;
    border-radius:15px;
    border:6px solid #2196F3;
}
h2{
    text-align:center;
    color:#3F51B5;
    margin:25px;
    font-size:35px;
    text-decoration:underline;
    text-shadow:2px 2px 4px gray;
}
p{
    text-align:justify;
    font-size:18px;
    line-height:30px;
    color:#333;
}
.container{
    display:flex;
    justify-content:space-around;
    margin-top:30px;
}
.card{
    width:30%;
    padding:20px;
    border-radius:15px;
    text-align:center;
}
.card1{
    background:#FFCDD2;
}
.card2{
    background:#FFF9C4;
}
.card3{
    background:#C8E6C9;
}
.card h3{
    color:#0D47A1;
    margin-bottom:15px;
}
.card ul{
    list-style-type:circle;
    text-align:left;
    margin-left:30px;
    font-size:18px;
}
footer{
    margin-top:40px;
    background:#212121;
    color:white;
    text-align:center;
    padding:20px;
    font-size:18px;
}
</style>
</head>
