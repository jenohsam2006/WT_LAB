<!DOCTYPE html>
<html>
<head>
<title>Simple Calculator URK24CS1154</title>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<style>
    body{font-family:Arial;text-align:center;background:#f2f2f2}
    .calculator{width:350px;margin:50px auto;background:white;padding:25px;border-radius:10px}
    input{width:85%;padding:10px;margin:10px}
    button{padding:10px 15px;margin:5px;background:#1683e8;color:white;border:0;border-radius:5px;cursor:pointer}
    #result{font-size:20px;font-weight:bold;margin-top:20px}
</style>
</head>
<body>
    <div class="calculator">
        <h2>Calculator URK24CS1154</h2>
        <input type="number" id="num1" placeholder="Enter first number">
        <input type="number" id="num2" placeholder="Enter second number">
        <br>
        <button id="add">Addition</button>
        <button id="sub">Subtraction</button>
        <button id="mul">Multiplication</button>
        <button id="div">Division</button>
        <div id="result">Result: </div>
    </div>
    <script>
        $(document).ready(function(){
            function getNumbers(){
            let a=parseFloat($("#num1").val());
            let b=parseFloat($("#num2").val());
            return [a,b];
            }
        $("#add").click(function(){
            let n=getNumbers();
            if(isNaN(n[0])||isNaN(n[1])){$("#result").text("Enter both numbers");return;}
            $("#result").text("Result: "+(n[0]+n[1]));
        });
        $("#sub").click(function(){
            let n=getNumbers();
            if(isNaN(n[0])||isNaN(n[1])){$("#result").text("Enter both numbers");return;}
            $("#result").text("Result: "+(n[0]-n[1]));
        });
        $("#mul").click(function(){
            let n=getNumbers();
            if(isNaN(n[0])||isNaN(n[1])){$("#result").text("Enter both numbers");return;}
            $("#result").text("Result: "+(n[0]*n[1]));
        });
        $("#div").click(function(){
            let n=getNumbers();
            if(isNaN(n[0])||isNaN(n[1])){$("#result").text("Enter both numbers");return;}
            if(n[1]==0){$("#result").text("Cannot divide by zero");return;}
            $("#result").text("Result: "+(n[0]/n[1]));
        });
    });
</script>
</body>
</html>


