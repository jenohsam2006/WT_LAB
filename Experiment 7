<!DOCTYPE html>
<html>
<head><title>Budget Calculator URK24CS1154</title>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<style>
body{font-family:Arial;text-align:center;background:#f2f2f2}
.container{width:500px;margin:50px auto;background:white;padding:25px;border-radius:10px}
input{width:80px;padding:8px;margin:5px}
button{padding:10px 20px;background:#1683e8;color:white;border:0;border-radius:5px;cursor:pointer}
.result{margin-top:20px;font-size:18px;font-weight:bold}
</style></head>
<body>
<div class="container">
<h2>Budget Calculator URK24CS1154</h2>
<input type="number" id="amount" placeholder="Amount"><br>
Room Rent (%) <input type="number" id="rent" value="50">
Accessories (%) <input type="number" id="accessories" value="20">
Emergency (%) <input type="number" id="emergency" value="20">
Saving (%) <input type="number" id="saving" value="10">
<br><br>
<button id="calculate">Calculate</button>
<div class="result" id="result"></div></div>
<script>
$(document).ready(function(){
$("#calculate").click(function(){
let amount=parseFloat($("#amount").val());
let rent=parseFloat($("#rent").val());
let accessories=parseFloat($("#accessories").val());
let emergency=parseFloat($("#emergency").val());
let saving=parseFloat($("#saving").val());
if(isNaN(amount)||amount<=0){
$("#result").text("Enter a valid amount");
return;
}
if(rent+accessories+emergency+saving!=100){
$("#result").text("Percentages must total 100%");
return;
}
$("#result").html("Room Rent: Rs."+amount*rent/100+"<br>Accessories: Rs."+amount*accessories/100+"<br>Emergency: Rs."+amount*emergency/100+"<br>Saving: Rs."+amount*saving/100);
});
});
</script>
</body>
</html>



