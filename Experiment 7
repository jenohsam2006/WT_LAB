<!DOCTYPE html>
<html>
<head><title>Product Card - jQuery Effects URK24CS1154</title>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<style>
    body{font-family:Arial;text-align:center;background:#f2f2f2}
    .container{width:500px;margin:40px auto}
    #product{background:white;padding:25px;border:2px solid #333;border-radius:10px}
    button{padding:10px 15px;margin:5px;border:0;background:#1683e8;color:white;border-radius:5px}
    #message{font-weight:bold;margin:20px}
</style>
</head><body>
    <div class="container">
    <h2>Product Details URK24CS1154</h2>
    <div id="product">
    <h2>Laptop Pro</h2>
    <p><b>Price:</b> ₹65,000</p>
    <p><b>Category:</b> Electronics</p>
    <p><b>Stock Status:</b> Available</p>
    <p><b>Description:</b> High-performance laptop for students and professionals.</p>
    </div><br>
    <button id="show">Show</button>
    <button id="hide">Hide</button>
    <button id="fade">Fade</button>
    <button id="slide">Slide</button>
    <button id="animate">Animate</button>
    <button id="stop">Stop Animation</button>
    <button id="callback">Callback</button>
    <button id="chain">Chaining</button>
    <button id="reset">Reset</button>
    <div id="message"></div></div>
<script>
$(document).ready(function(){
$("#show").click(function(){
$("#product").show();
});
$("#hide").click(function(){
$("#product").hide();
});
$("#fade").click(function(){
$("#product").fadeToggle(1000);
});
$("#slide").click(function(){
$("#product").slideToggle(1000);
});
$("#animate").click(function(){
$("#product").animate({width:"300px",marginLeft:"100px",fontSize:"18px"},2000);
});
$("#stop").click(function(){
$("#product").stop();
});
$("#callback").click(function(){
$("#product").fadeOut(1000,function(){
$("#message").text("Animation completed successfully");
$("#product").fadeIn(1000);
});
});
$("#chain").click(function(){
$("#product").slideUp(500).slideDown(500).fadeOut(500).fadeIn(500);
});
$("#reset").click(function(){
$("#product").stop(true,true).show().css({
width:"",
marginLeft:"",
fontSize:""
});
$("#message").text("");
});
});
</script>
</body>
</html>


