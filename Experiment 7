<!DOCTYPE html>
<html>
<head><title>Car Body Workshop URK24CS1154</title>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<style>
    body{font-family:Arial;text-align:center;background:#f2f2f2}
    .car{width:350px;height:200px;margin:30px auto;position:relative}
    .body{width:280px;height:80px;background:green;position:absolute;left:35px;top:70px;border-radius:20px}
    .roof{width:140px;height:60px;background:skyblue;position:absolute;left:105px;top:20px;border-radius:60px 60px 0 0}
    .wheel{width:50px;height:50px;background:black;border-radius:50%;position:absolute;top:130px}
    .wheel1{left:65px}
    .wheel2{right:65px}
    button{padding:10px;margin:5px;background:#1683e8;color:white;border:0;border-radius:5px;cursor:pointer}
</style>
</head>
<body>
    <h2>Car Body Workshop URK24CS1154</h2>
    <div class="car">
    <div class="roof"></div>
    <div class="body"></div>
    <div class="wheel wheel1"></div>
    <div class="wheel wheel2"></div></div>
    <button id="red">Red Car</button>
    <button id="blue">Blue Car</button>
    <button id="green">Green Car</button>
    <button id="darkGlass">Dark Glass</button>
    <button id="tyre">Increase Tyre</button>
    <button id="reset">Reset</button>
<script>
    $(document).ready(function(){
    $("#red").click(function(){$(".body").css("background","red")});
    $("#blue").click(function(){$(".body").css("background","blue")});
    $("#green").click(function(){$(".body").css("background","green")});
    $("#darkGlass").click(function(){$(".roof").css("background","black")});
    $("#tyre").click(function(){$(".wheel").css({"width":"70px","height":"70px"})});
    $("#reset").click(function(){
    $(".body").css("background","green");
    $(".roof").css("background","skyblue");
    $(".wheel").css({"width":"50px","height":"50px"});
});
});
</script>
</body>
</html>



