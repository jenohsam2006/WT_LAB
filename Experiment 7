</style>
</head>
<body>
<div class="container">
<h2>CAKE SHOP URK24CS1154</h2>
<p>Color Cake - Rs.300</p>
<input type="number" id="color" value="0" min="0">
<p>Brown Cake - Rs.200</p>
<input type="number" id="brown" value="0" min="0">
<p>Milky Cake - Rs.250</p>
<input type="number" id="milky" value="0" min="0">
<p>Black Forest Cake - Rs.350</p>
<input type="number" id="black" value="0" min="0">
<br><br>
<button id="order">Place Order</button>
<div id="result">Total Price: Rs.0</div>
</div>
<script>
$(document).ready(function(){
$("#order").click(function(){
let color=parseInt($("#color").val())||0;
let brown=parseInt($("#brown").val())||0;
let milky=parseInt($("#milky").val())||0;
let black=parseInt($("#black").val())||0;
let total=color*300+brown*200+milky*250+black*350;
$("#result").text("Total Price: Rs."+total);
});
});
</script>
</body>
</html>



