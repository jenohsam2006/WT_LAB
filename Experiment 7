<html>
<head>
<title>Cake Order Calculator URK24CS1154</title>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<style>
body{font-family:Arial;text-align:center;background:#f5f5f5}
.container{width:500px;margin:40px auto;background:white;padding:25px;border-radius:10px}
input{width:100px;padding:8px;margin:8px}
button{padding:10px 30px;background:#d00000;color:white;border:0;border-radius:5px;cursor:pointer}
